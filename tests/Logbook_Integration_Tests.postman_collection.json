		{
			"name": "TC-INVERIFY-01: Mentor menyetujui logbook (Verified)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Status logbook berubah menjadi verified\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.status_verifikasi).to.eql(\"verified\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{mentor_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"status_verifikasi\": \"verified\",\n    \"feedback\": \"Sangat baik, silakan dilanjutkan.\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/logbooks/1/verify",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"mentor",
						"logbook",
						"1",
						"verify"
					]
				}
			},
			"response": []
		},
